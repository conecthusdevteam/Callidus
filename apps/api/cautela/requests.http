@cautelaAprovadaId = COLE_O_ID_DA_CAUTELA_APROVADA_AQUI
# Depois de rodar "Autorizar saida", normalmente este ID deve ser igual ao @cautelaAprovadaId.
@cautelaSaidaAutorizadaId = 7A2E433E-F36B-1410-8B27-0051659C6E99
@cautelaEncerradaId = 7A2E433E-F36B-1410-8B27-0051659C6E99
@cautelaReprovadaId = COLE_O_ID_DA_CAUTELA_REPROVADA_AQUI
@cautelaDeOutroGestorId = COLE_O_ID_DA_CAUTELA_DE_OUTRO_GESTOR_AQUI
@cautelaDeOutraPortariaId = COLE_O_ID_DA_CAUTELA_DE_OUTRA_PORTARIA_AQUI

###
# 0) Health check
GET {{baseUrl}}/

###
# 1) Criar primeiro ADMIN
# Só funciona enquanto não existir nenhum usuário na base.
POST {{baseUrl}}/users
Content-Type: {{json}}

{
  "nome": "Administrador Inicial",
  "email": "admin@cautela.local",
  "senha": "123456",
  "papel": "ADMIN"
}

###
# 2) Login ADMIN
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "admin.cautela@callidus.local",
  "senha": "123456"
}

###
# 3) Criar GESTOR
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "nome": "Gestor Teste",
  "email": "gestor@cautela.local",
  "senha": "123456",
  "papel": "GESTOR"
}

###
# 4) Criar PORTARIA
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "nome": "Portaria Teste",
  "email": "portaria@cautela.local",
  "senha": "123456",
  "papel": "PORTARIA"
}

###
# 5) Criar SOLICITANTE
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "nome": "Solicitante Teste",
  "email": "solicitante@cautela.local",
  "senha": "123456",
  "papel": "SOLICITANTE"
}

###
# 6) Listar usuários
# Use para preencher @gestorId se não estiver usando seed.
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

###
# 7) Criar setor
POST {{baseUrl}}/sectors
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "numeroSetor": 101,
  "nome": "Tecnologia",
  "gestorId": "{{gestorId}}"
}

###
# 8) Listar setores
# Use para preencher @setorId.
GET {{baseUrl}}/sectors
Authorization: Bearer {{adminToken}}

###
# 9) Login PORTARIA
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "portaria@cautela.local",
  "senha": "123456"
}

###
# 10) Login GESTOR
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "gestor.ti@callidus.local",
  "senha": "123456"
}

###
# 11) Login SOLICITANTE
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "solicitante@cautela.local",
  "senha": "123456"
}

###
# 12) Criar cautela pelo solicitante
# Valida: empresa, documentoProprietario e itens com descricao + quantidade.
POST {{baseUrl}}/cautelas
Authorization: Bearer {{solicitanteToken}}
Content-Type: {{json}}

{
  "setorId": "{{setorId}}",
  "proprietarioNome": "Lucas Araujo",
  "empresa": "Callidus",
  "documentoProprietario": "12345678900",
  "proprietarioEmail": "lucas@conecthus.org.br",
  "itens": [
    {
      "descricao": "Carregador IPhone",
      "quantidade": 1
    },
    {
      "descricao": "IPhone",
      "quantidade": 1
    }
  ]
}

###
# 13) Criar cautela simples
POST {{baseUrl}}/cautelas
Authorization: Bearer {{solicitanteToken}}
Content-Type: {{json}}

{
  "setorId": "{{setorId}}",
  "proprietarioNome": "Visitante Sem Retorno",
  "empresa": "Fornecedor Sem Retorno",
  "documentoProprietario": "98765432100",
  "proprietarioEmail": "visitante.sem.retorno@teste.com",
  "itens": [
    {
      "descricao": "Capacete de seguranca",
      "quantidade": 1
    }
  ]
}

###
# 14) Compatibilidade: criar cautela usando o campo antigo nomeItem
POST {{baseUrl}}/cautelas
Authorization: Bearer {{solicitanteToken}}
Content-Type: {{json}}

{
  "setorId": "{{setorId}}",
  "proprietarioNome": "Visitante Legado",
  "empresa": "Empresa Legado",
  "documentoProprietario": "11222333444",
  "proprietarioEmail": "visitante.legado@teste.com",
  "itens": [
    {
      "nomeItem": "Projetor Epson",
      "quantidade": 1
    }
  ]
}

###
# 15) Listar cautelas da portaria
# Verifique: empresa, documentoProprietario, itens[].descricao, statusVisualPortaria,
# badgePortaria, badgeGestor, saidaAutorizada, dataStatus e acoesDisponiveis.
GET {{baseUrl}}/cautelas
Authorization: Bearer {{portariaToken}}

###
# 16) Listar cautelas do gestor
# Verifique cautelas EM_ANALISE aguardando aprovacao.
GET {{baseUrl}}/cautelas
Authorization: Bearer {{gestorToken}}

###
# 17) Listar cautelas em analise
GET {{baseUrl}}/cautelas?respondidas=false
Authorization: Bearer {{gestorToken}}

###
# 18) Detalhe de cautela em analise
# Use uma cautela EM_ANALISE e preencha @cautelaEmAnaliseId.
GET {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}
Authorization: Bearer {{gestorToken}}

###
# 19) Aprovar cautela pelo gestor
# Resultado esperado: status EM_ANALISE, etapaFluxo APROVADA_PELO_GESTOR.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/aprovar
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{
  "tipoPermissao": "ENTRADA_UNICA"
}

###
# 20) Detalhe apos aprovacao do gestor
GET {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}
Authorization: Bearer {{gestorToken}}

###
# 21) Validar entrada pela portaria
# Resultado esperado: status APROVADA, etapaFluxo VALIDADA_PELA_PORTARIA.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/validar-entrada
Authorization: Bearer {{portariaToken}}

###
# 22) Invalidar entrada pela portaria
# Motivo opcional. Use uma cautela aprovada pelo gestor e ainda pendente da portaria.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/invalidar-entrada
Authorization: Bearer {{portariaToken}}
Content-Type: {{json}}

{
  "justificativa": "Entrada fisica nao autorizada pela portaria."
}

###
# 23) Alterar tipo de permissao pelo gestor
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/tipo-permissao
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{
  "tipoPermissao": "ENTRADA_UNICA"
}

###
# 24) Marcar cautela como visualizada pelo usuario autenticado
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/visualizar
Authorization: Bearer {{solicitanteToken}}

###
# 25) Autorizar saida pelo gestor
# Resultado esperado:
# status continua APROVADA;
# saidaAutorizada = true;
# badgeGestor = AGUARDANDO_SAIDA;
# badgePortaria = ACAO_NECESSARIA;
# statusVisualPortaria = ATENCAO;
# evento SAIDA_AUTORIZADA no detalhe.
# Depois de executar este passo com sucesso, copie este mesmo ID para @cautelaSaidaAutorizadaId.
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/autorizar-saida
Authorization: Bearer {{gestorToken}}

###
# 20) Portaria consulta cautelas apos autorizacao de saida
# Deve aparecer com statusVisualPortaria ATENCAO e badgePortaria ACAO_NECESSARIA.
GET {{baseUrl}}/cautelas
Authorization: Bearer {{portariaToken}}

###
# 21) Detalhe da cautela com saida autorizada pela portaria
GET {{baseUrl}}/cautelas/{{cautelaAprovadaId}}
Authorization: Bearer {{portariaToken}}

###
# 22) Permitir saida pela portaria
# Resultado esperado: status ENCERRADA, encerradoEm preenchido, badges nulos.
# Use o mesmo ID autorizado no passo 19.
PATCH {{baseUrl}}/cautelas/{{cautelaSaidaAutorizadaId}}/permitir-saida
Authorization: Bearer {{portariaToken}}

###
# 23) Detalhe da cautela encerrada
# Verifique aprovadoEm, saidaAutorizadaEm, encerradoEm e eventos.
GET {{baseUrl}}/cautelas/{{cautelaSaidaAutorizadaId}}
Authorization: Bearer {{portariaToken}}

###
# 24) Buscar por ID
GET {{baseUrl}}/cautelas?search={{cautelaEncerradaId}}
Authorization: Bearer {{portariaToken}}

###
# 25) Buscar por nome do proprietario
GET {{baseUrl}}/cautelas?search=Lucas
Authorization: Bearer {{portariaToken}}

###
# 26) Buscar por empresa
GET {{baseUrl}}/cautelas?search=Callidus
Authorization: Bearer {{portariaToken}}

###
# 27) Buscar por status ENCERRADA
GET {{baseUrl}}/cautelas?search=ENCERRADA
Authorization: Bearer {{portariaToken}}

###
# 28) Filtrar por status ENCERRADA
GET {{baseUrl}}/cautelas?status=ENCERRADA
Authorization: Bearer {{portariaToken}}

###
# 29) Polling: buscar cautelas atualizadas desde uma data
GET {{baseUrl}}/cautelas?updatedSince=2026-01-01T00:00:00.000Z
Authorization: Bearer {{portariaToken}}

###
# 30) Fluxo negativo: portaria tentando autorizar saida
# Esperado: 403.
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/autorizar-saida
Authorization: Bearer {{portariaToken}}

###
# 31) Fluxo negativo: gestor tentando permitir saida
# Esperado: 403.
PATCH {{baseUrl}}/cautelas/{{cautelaSaidaAutorizadaId}}/permitir-saida
Authorization: Bearer {{gestorToken}}

###
# 32) Fluxo negativo: autorizar saida de cautela em analise
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/autorizar-saida
Authorization: Bearer {{gestorToken}}

###
# 33) Fluxo negativo: permitir saida sem autorizacao previa
# Use uma cautela APROVADA sem saidaAutorizadaEm.
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/permitir-saida
Authorization: Bearer {{portariaToken}}

###
# 34) Fluxo negativo: autorizar saida de cautela encerrada
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaEncerradaId}}/autorizar-saida
Authorization: Bearer {{gestorToken}}

###
# 35) Fluxo negativo: permitir saida de cautela encerrada novamente
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaEncerradaId}}/permitir-saida
Authorization: Bearer {{portariaToken}}

###
# 36) Fluxo de rejeicao em cautela separada
# Use uma cautela EM_ANALISE diferente da usada para aprovacao.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/reprovar
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{
  "justificativa": "Equipamento sem autorizacao do setor."
}

###
# 37) Refresh token
# Cole manualmente o refreshToken retornado no login.
POST {{baseUrl}}/auth/refresh
Content-Type: {{json}}

{
  "refreshToken": "COLE_O_REFRESH_TOKEN_AQUI"
}

###
# 38) Encerrar sessao atual
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{}

###
# 39) Encerrar todas as sessoes
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{gestorToken}}

