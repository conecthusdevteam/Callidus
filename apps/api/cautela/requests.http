###
# 47) Negativo aprovacao: portaria tentando aprovar
# Esperado: 403.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/aprovar
Authorization: Bearer {{portariaToken}}

###
# 48) Negativo aprovacao: aprovar cautela ja aprovada
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/aprovar
Authorization: Bearer {{gestorToken}}

###
# 49) Negativo rejeicao: portaria tentando reprovar
# Esperado: 403.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/reprovar
Authorization: Bearer {{portariaToken}}
Content-Type: {{json}}

{
  "justificativa": "Tentativa por perfil indevido."
}

###
# 50) Negativo rejeicao: reprovar sem justificativa
# Esperado: 400.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/reprovar
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{
  "justificativa": ""
}

###
# 51) Negativo rejeicao: reprovar cautela ja aprovada
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaAprovadaId}}/reprovar
Authorization: Bearer {{gestorToken}}
Content-Type: {{json}}

{
  "justificativa": "Tentativa de reprovar cautela ja aprovada."
}

###
# 52) Negativo saida: autorizar saida duas vezes
# Rode uma vez depois que @cautelaSaidaAutorizadaId ja tiver saida autorizada.
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaSaidaAutorizadaId}}/autorizar-saida
Authorization: Bearer {{gestorToken}}

###
# 53) Negativo saida: permitir saida de cautela em analise
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaEmAnaliseId}}/permitir-saida
Authorization: Bearer {{portariaToken}}

###
# 54) Negativo saida: permitir saida de cautela reprovada
# Esperado: 409.
PATCH {{baseUrl}}/cautelas/{{cautelaReprovadaId}}/permitir-saida
Authorization: Bearer {{portariaToken}}

###
# 55) Permissao: requisicao sem token
# Esperado: 401.
GET {{baseUrl}}/cautelas

###
# 56) Permissao: token invalido
# Esperado: 401.
GET {{baseUrl}}/cautelas
Authorization: Bearer token.invalido

###
# 57) Permissao: gestor acessando cautela de outro gestor
# Esperado: 403.
GET {{baseUrl}}/cautelas/{{cautelaDeOutroGestorId}}
Authorization: Bearer {{gestorToken}}

###
# 58) Permissao: portaria acessando cautela criada por outra portaria
# Esperado: 403, se a regra de acesso por solicitadoPorId continuar ativa.
GET {{baseUrl}}/cautelas/{{cautelaDeOutraPortariaId}}
Authorization: Bearer {{portariaToken}}

###
# 59) Filtro: cautelas respondidas
GET {{baseUrl}}/cautelas?respondidas=true
Authorization: Bearer {{gestorToken}}

###
# 60) Filtro: status APROVADA
GET {{baseUrl}}/cautelas?status=APROVADA
Authorization: Bearer {{gestorToken}}

###
# 61) Filtro: status EM_ANALISE
GET {{baseUrl}}/cautelas?status=EM_ANALISE
Authorization: Bearer {{gestorToken}}

###
# 62) Filtro: status REPROVADA
GET {{baseUrl}}/cautelas?status=REPROVADA
Authorization: Bearer {{gestorToken}}

###
# 63) Filtro combinado: search + status
GET {{baseUrl}}/cautelas?search=Lucas&status=APROVADA
Authorization: Bearer {{portariaToken}}

###
# 64) Busca sem resultado
# Esperado: 200 com lista vazia.
GET {{baseUrl}}/cautelas?search=NAO_DEVE_EXISTIR_123456
Authorization: Bearer {{portariaToken}}

###
# 65) Auth: login com senha errada
# Esperado: 401.
POST {{baseUrl}}/auth/login
Content-Type: {{json}}

{
  "email": "gestor@cautela.local",
  "senha": "senha-errada"
}

###
# 66) Auth: refresh token invalido
# Esperado: 401.
POST {{baseUrl}}/auth/refresh
Content-Type: {{json}}

{
  "refreshToken": "refresh.invalido"
}

###
# 67) Auth: logout sem token
# Esperado: 401.
POST {{baseUrl}}/auth/logout
Content-Type: {{json}}

{}

###
# 68) Users: dados do usuario autenticado
GET {{baseUrl}}/users/me
Authorization: Bearer {{gestorToken}}

###
# 69) Users: listar por papel GESTOR
GET {{baseUrl}}/users?papel=GESTOR
Authorization: Bearer {{adminToken}}

###
# 70) Users: listar ativos
GET {{baseUrl}}/users?ativo=true
Authorization: Bearer {{adminToken}}

###
# 71) Users: buscar usuario por ID
GET {{baseUrl}}/users/{{usuarioParaAtualizarId}}
Authorization: Bearer {{adminToken}}

###
# 72) Users: atualizar usuario
PATCH {{baseUrl}}/users/{{usuarioParaAtualizarId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "nome": "Usuario Atualizado",
  "ativo": true
}

###
# 73) Users: inativar usuario
DELETE {{baseUrl}}/users/{{usuarioParaInativarId}}
Authorization: Bearer {{adminToken}}

###
# 74) Users negativo: portaria tentando listar usuarios
# Esperado: 403.
GET {{baseUrl}}/users
Authorization: Bearer {{portariaToken}}

###
# 75) Sectors: listar setores ativos
GET {{baseUrl}}/sectors?ativo=true
Authorization: Bearer {{adminToken}}

###
# 76) Sectors: buscar setor por ID
GET {{baseUrl}}/sectors/{{setorParaAtualizarId}}
Authorization: Bearer {{adminToken}}

###
# 77) Sectors: atualizar setor
PATCH {{baseUrl}}/sectors/{{setorParaAtualizarId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "nome": "Tecnologia Atualizada",
  "ativo": true
}

###
# 78) Sectors: inativar setor
# Depois copie este ID para @setorInativoId para testar o bloco 46.
DELETE {{baseUrl}}/sectors/{{setorParaInativarId}}
Authorization: Bearer {{adminToken}}

###
# 79) Sectors negativo: portaria tentando criar setor
# Esperado: 403.
POST {{baseUrl}}/sectors
Authorization: Bearer {{portariaToken}}
Content-Type: {{json}}

{
  "numeroSetor": 999,
  "nome": "Setor Indevido",
  "gestorId": "{{gestorId}}"
}

###
# 80) Sectors negativo: criar setor com gestor inexistente
# Esperado: 400.
POST {{baseUrl}}/sectors
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "numeroSetor": 998,
  "nome": "Setor Gestor Inexistente",
  "gestorId": "00000000-0000-0000-0000-000000000000"
}

###
# 81) Sectors negativo: criar setor com numero repetido
# Esperado: 409, se numeroSetor 101 ja existir.
POST {{baseUrl}}/sectors
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "numeroSetor": 101,
  "nome": "Setor Numero Repetido",
  "gestorId": "{{gestorId}}"
}

