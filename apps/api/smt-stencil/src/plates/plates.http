@baseUrl=http://localhost:5000
@plateId=plate_RUs-sxLxx3EFz5mr-PnXq
@missingPlateId=plate_missing
@uniquePlateModel=REST-PLATE-{{$timestamp}}
@uniquePlateSerial=REST-SERIAL-{{$timestamp}}

### Health check
GET {{baseUrl}}/

### List plates - success
GET {{baseUrl}}/plates

### List plates filtered by line - success
GET {{baseUrl}}/plates?linha=Linha%201

### List plates with no results - success with empty array
GET {{baseUrl}}/plates?linha=Linha%20Inexistente

### List available lines - success
GET {{baseUrl}}/linhas

### Get plate by id - success
GET {{baseUrl}}/plates/{{plateId}}

### Create plate wash by plate id - success
# Depois rode "Get plate by id" para ver historico_lavagens atualizado.
POST {{baseUrl}}/plates/{{plateId}}/lavagens
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": 2,
  "phase": 1
}

### Create plate wash with custom date/time - 400 expected
# createdAt e gerado automaticamente pelo backend para lavagens de placas.
POST {{baseUrl}}/plates/{{plateId}}/lavagens
Content-Type: application/json

{
  "operator": "Pedro Costa",
  "shift": 3,
  "phase": 2,
  "createdAt": "2026-05-13T10:30:00.000Z"
}

### Create plate wash for missing plate - 404 expected
POST {{baseUrl}}/plates/{{missingPlateId}}/lavagens
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": 2,
  "phase": 1
}

### Create plate wash with invalid body - 400 expected
POST {{baseUrl}}/plates/{{plateId}}/lavagens
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": "segundo",
  "phase": 1,
  "createdAt": "data-invalida"
}

### Get missing plate by id - 404 expected
GET {{baseUrl}}/plates/{{missingPlateId}}

### Create plate - success
# @name createPlate
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "plateModel": "{{uniquePlateModel}}",
  "serialNumber": "{{uniquePlateSerial}}",
  "blankId": "BLANK-REST",
  "lineName": "Linha REST",
  "plateManufacturerId": "MNF-REST",
  "country": "Brasil",
  "thickness": 0.09,
  "addressing": "012"
}

### Create duplicated plate model - 409 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "plateModel": "{{uniquePlateModel}}",
  "serialNumber": "{{uniquePlateSerial}}-DUP",
  "blankId": "BLANK-REST",
  "lineName": "Linha REST"
}

### Create plate with missing required fields - 400 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "plateModel": "INVALID-{{$timestamp}}"
}

### Create plate with invalid number field - 400 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "plateModel": "INVALID-THICKNESS-{{$timestamp}}",
  "serialNumber": "SERIAL-{{$timestamp}}",
  "blankId": "BLANK-REST",
  "lineName": "Linha REST",
  "thickness": "fino"
}

### Update plate line - success
PATCH {{baseUrl}}/plates/{{plateId}}
Content-Type: application/json

{
  "lineName": "Linha 2"
}

### Update missing plate - 404 expected
PATCH {{baseUrl}}/plates/{{missingPlateId}}
Content-Type: application/json

{
  "lineName": "Linha 2"
}

### Update plate with invalid number field - 400 expected
PATCH {{baseUrl}}/plates/{{plateId}}
Content-Type: application/json

{
  "thickness": "fino"
}

### Delete plate - success, 204 expected
DELETE {{baseUrl}}/plates/{{plateId}}

### Delete missing plate - 404 expected
DELETE {{baseUrl}}/plates/{{missingPlateId}}
