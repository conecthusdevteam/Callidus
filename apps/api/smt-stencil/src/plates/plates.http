@baseUrl=http://localhost:5000
@plateId=p_1oC45kmo1RnSG-E-fagHz
@missingPlateId=plate_missing
@uniquePlateModel=REST{{$timestamp}}
@uniquePlateType=MAIN
@uniquePlateCode={{uniquePlateModel}}_{{uniquePlateType}}

### Health check
GET {{baseUrl}}/

### List plates - success
GET {{baseUrl}}/plates

### Daily wash summary - success
GET {{baseUrl}}/washes/daily-summary

### List recent plate washes - success
GET {{baseUrl}}/plates/washes?page=1&limit=10

### List today plate washes - success
GET {{baseUrl}}/plates/washes/today?page=1&limit=10

### List plates paginated - success
GET {{baseUrl}}/plates?page=1&limit=10

### List plates filtered by model - success
GET {{baseUrl}}/plates?plate_model=PCB

### List plates filtered by blank id - success
GET {{baseUrl}}/plates?blank_id=BLANK

### List plates filtered by serial - success
GET {{baseUrl}}/plates?serial=PCB

### List plates filtered by line - success
GET {{baseUrl}}/plates?line=Linha%201

### List plates filtered by multiple fields - success
GET {{baseUrl}}/plates?plate_model=PCB&blank_id=BLANK&serial=PCB&line=Linha%201&page=1&limit=10

### List plates with no results - success with empty array
GET {{baseUrl}}/plates?line=Linha%20Inexistente

### List available lines - success
GET {{baseUrl}}/lines

### Get plate by id - success
GET {{baseUrl}}/plates/{{plateId}}

### Create plate wash by plate id - success
# Depois rode "Get plate by id" para ver historico_lavagens atualizado.
POST {{baseUrl}}/plates/{{plateId}}/washes
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": 2,
  "phase": 1
}

### Create plate wash with custom date/time - 400 expected
# createdAt e gerado automaticamente pelo backend para lavagens de placas.
POST {{baseUrl}}/plates/{{plateId}}/washes
Content-Type: application/json

{
  "operator": "Pedro Costa",
  "shift": 3,
  "phase": 2,
  "createdAt": "2026-05-13T10:30:00.000Z"
}

### Create plate wash for missing plate - 404 expected
POST {{baseUrl}}/plates/{{missingPlateId}}/washes
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": 2,
  "phase": 1
}

### Create plate wash with invalid body - 400 expected
POST {{baseUrl}}/plates/{{plateId}}/washes
Content-Type: application/json

{
  "operator": "Maria Santos",
  "shift": "segundo",
  "phase": 1,
  "createdAt": "data-invalida"
}

### Get missing plate by id - 404 expected
GET {{baseUrl}}/plates/{{missingPlateId}}

### Create plate - success
# @name createPlate
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "model": "{{uniquePlateModel}}",
  "plateType": "{{uniquePlateType}}",
  "phases": "two_phases",
  "platesPerBlank": 2
}

### Create duplicated plate code - 409 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "model": "{{uniquePlateModel}}",
  "plateType": "{{uniquePlateType}}",
  "phases": "two_phases",
  "platesPerBlank": 2
}

### Create plate with missing required fields - 400 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "model": "INVALID-{{$timestamp}}"
}

### Create plate with invalid plates per blank - 400 expected
POST {{baseUrl}}/plates
Content-Type: application/json

{
  "model": "INVALID-{{$timestamp}}",
  "plateType": "MAIN",
  "phases": "single_phase",
  "platesPerBlank": 0
}

### Update plate registration - success
PATCH {{baseUrl}}/plates/{{plateId}}
Content-Type: application/json

{
  "model": "P3H&P3K",
  "plateType": "MAIN",
  "phases": "single_phase",
  "platesPerBlank": 1
}

### Update missing plate - 404 expected
PATCH {{baseUrl}}/plates/{{missingPlateId}}
Content-Type: application/json

{
  "model": "P3H&P3K",
  "plateType": "MAIN",
  "phases": "single_phase",
  "platesPerBlank": 1
}

### Update plate with invalid phases - 400 expected
PATCH {{baseUrl}}/plates/{{plateId}}
Content-Type: application/json

{
  "phases": "three_phases"
}

### Delete plate - success, 204 expected
DELETE {{baseUrl}}/plates/{{plateId}}

### Delete missing plate - 404 expected
DELETE {{baseUrl}}/plates/{{missingPlateId}}
